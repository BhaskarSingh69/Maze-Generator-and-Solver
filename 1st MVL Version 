// maze_mvp.cpp - MAZE GENERATOR AND  
// SOLVER, version 1 (First Cut / MVP)
// What it does
//   1. Builds a random maze   
//   2. Solves it                    
//   3. Prints the maze and the route

#include <algorithm>
#include <cstdlib>
#include <ctime>
#include <iostream>
#include <queue>
#include <string>
#include <utility>
#include <vector>
using namespace std;

const int ROWS = 21;  
const int COLS = 41;

vector<string> grid;   

// The 4 directions: up, down, left,right
const int dr[4] = {-1, 1, 0, 0};
const int dc[4] = {0, 0, -1, 1};

void carve(int r, int c) {
    grid[r][c] = ' ';

    int order[4] = {0, 1, 2, 3};
    for (int i = 3; i > 0; i--) {            
        int j = rand() % (i + 1);
        swap(order[i], order[j]);
    }

    for (int i = 0; i < 4; i++) {
        int d = order[i];
        int nr = r + dr[d] * 2;                
        int nc = c + dc[d] * 2;

        bool inside = nr > 0 && nr < ROWS - 1 && nc > 0 && nc < COLS - 1;
        if (inside && grid[nr][nc] == '#') {
            grid[r + dr[d]][c + dc[d]] = ' '; 
            carve(nr, nc);                    
        }
    }
}

bool solve() {
    int sr = 1, sc = 1;                         top-left room
    int er = ROWS - 2, ec = COLS - 2;         
    vector<vector<pair<int, int> > > from(ROWS, vector<pair<int, int> >(COLS, make_pair(-1, -1)));
    vector<vector<bool> > seen(ROWS, vector<bool>(COLS, false));

    queue<pair<int, int> > q;
    q.push(make_pair(sr, sc));
    seen[sr][sc] = true;

    while (!q.empty()) {
        int r = q.front().first;
        int c = q.front().second;
        q.pop();

        if (r == er && c == ec) {            
            while (!(r == sr && c == sc)) {
                grid[r][c] = '*';
                pair<int, int> p = from[r][c];
                r = p.first;
                c = p.second;
            }
            return true;
        }

        for (int d = 0; d < 4; d++) {
            int nr = r + dr[d];
            int nc = c + dc[d];
            if (grid[nr][nc] != '#' && !seen[nr][nc]) {
                seen[nr][nc] = true;
                from[nr][nc] = make_pair(r, c);
                q.push(make_pair(nr, nc));
            }
        }
    }
    return false;                             
}

void printMaze() {
    for (int r = 0; r < ROWS; r++) cout << grid[r] << "\n";
}

int main(int argc, char* argv[]) {
    unsigned seed = (argc > 1) ? (unsigned)atoi(argv[1]) : (unsigned)time(0);
    srand(seed);

    grid.assign(ROWS, string(COLS, '#'));      

    carve(1, 1);                              
    cout << "Maze (seed " << seed << ")\n";
    printMaze();

    if (solve()) {                            
        grid[1][1] = 'S';
        grid[ROWS - 2][COLS - 2] = 'E';
        cout << "\nSolved (route = *)\n";
        printMaze();                          
    } else {
        cout << "No route found.\n";
    }
    return 0;
}
